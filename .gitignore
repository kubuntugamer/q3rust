target/

# Debug build trees are compile output: objects, engine binaries, game
# modules and generated configs. Build them with
# `make -C code/unix ARCH=x86_64`; a checkout should not carry them.
code/unix/debugx86_64/

# The i386 build tree is output for a dead target: the 2005 release already
# covers that architecture, and no 32-bit object can be loaded by the 64-bit
# engine anyway.
code/unix/debugi386/
/build_phase*.log

# Retail game data belongs to id, not to this repository. The engine reads it
# from the player's own installation (~/.q3a/baseq3); never vendor a pak here,
# and never extract the QVMs or media out of one into the tree.
*.pk3
*.qvm

# Packages built by game-data-packager are build outputs too, and they are
# large: keep a stray one out of the tree.
*.deb
